datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  currency  String    @default("USD")
  timezone  String    @default("UTC")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  branches     Branch[]
  designations Designation[]
  employees    Employee[]
  leaveTypes   LeaveType[]

  @@map("companies")
}

model Branch {
  id             String    @id @default(cuid())
  companyId      String
  name           String
  code           String    @unique
  timezone       String    @default("UTC")
  address        String?
  phone          String?
  email          String?
  isHeadquarters Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userBranches UserBranch[]
  userRoles    UserRole[]
  auditLogs    AuditLog[]
  settings     Setting[]
  departments        Department[]
  shifts             Shift[]
  employees          Employee[]
  rawAttendanceLogs  RawAttendanceLog[]
  attendanceRecords  AttendanceRecord[]
  leaveRequests      LeaveRequest[]

  @@index([companyId])
  @@map("branches")
}

model Department {
  id        String    @id @default(cuid())
  branchId  String
  parentId  String?
  name      String
  code      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Department[] @relation("DepartmentHierarchy")
  employees Employee[]

  @@unique([branchId, code])
  @@index([branchId])
  @@index([parentId])
  @@map("departments")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  name                 String
  passwordHash         String
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]  @default([])
  activeBranchId       String?
  status               String    @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  userBranches UserBranch[]
  userRoles    UserRole[]
  auditLogs    AuditLog[]
  employee     Employee?

  @@index([email])
  @@index([status])
  @@map("users")
}

model Role {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  module      String   // AUTH, ORG, HR, PAYROLL, ACCOUNTS, INVENTORY, WORKFLOW, OPERATIONS
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  branchId  String?  // null indicates organization wide / global access
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_roles")
}

model UserBranch {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_branches")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  branchId  String?
  action    String   // CREATE, UPDATE, DELETE, LOGIN, LOGIN_FAILED, BRANCH_ACCESS_DENIED, 2FA_RESET
  entity    String   // table or domain entity name
  entityId  String   // affected record ID
  before    Json?    // previous state snapshot
  after     Json?    // updated state snapshot
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([branchId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id          String   @id @default(cuid())
  branchId    String?  // null indicates global system setting
  key         String
  value       String
  version     Int      @default(1)
  isEncrypted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, key])
  @@index([key])
  @@map("settings")
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum TransitionType {
  HIRED
  PROMOTION
  TRANSFER
  DEPARTMENT_CHANGE
  SALARY_ADJUSTMENT
  SUSPENSION
  RESIGNATION
  TERMINATION
}

model Designation {
  id          String    @id @default(cuid())
  companyId   String
  title       String
  code        String
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("designations")
}

model Shift {
  id                 String    @id @default(cuid())
  branchId           String
  name               String
  code               String
  startTime          String
  endTime            String
  gracePeriodMinutes Int       @default(15)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employees Employee[]
  attendanceRecords AttendanceRecord[]

  @@unique([branchId, code])
  @@index([branchId])
  @@map("shifts")
}

model Employee {
  id               String         @id @default(cuid())
  userId           String?        @unique
  companyId        String
  branchId         String
  departmentId     String
  designationId    String
  shiftId          String?
  employeeNumber   String
  firstName        String
  lastName         String
  email            String
  phone            String?
  dateOfBirth      DateTime?
  gender           String?
  joinDate         DateTime
  confirmationDate DateTime?
  status           EmployeeStatus @default(ACTIVE)
  employmentType   EmploymentType @default(FULL_TIME)
  baseSalary       Int            // minor currency units (cents)
  bankName         String?
  bankAccount      String?
  emergencyContact String?
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user              User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch            Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department        Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designation       Designation          @relation(fields: [designationId], references: [id], onDelete: Restrict)
  shift             Shift?               @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  transitions       EmployeeTransition[]
  attendanceRecords AttendanceRecord[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]

  @@unique([companyId, employeeNumber])
  @@unique([companyId, email])
  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([designationId])
  @@index([status])
  @@map("employees")
}

model EmployeeTransition {
  id                String         @id @default(cuid())
  employeeId        String
  transitionType    TransitionType
  effectiveDate     DateTime
  fromBranchId      String?
  toBranchId        String?
  fromDepartmentId  String?
  toDepartmentId    String?
  fromDesignationId String?
  toDesignationId   String?
  previousSalary    Int?
  newSalary         Int?
  remarks           String?
  approvedByUserId  String?
  createdAt         DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([effectiveDate])
  @@map("employee_transitions")
}

enum PunchType {
  CHECK_IN
  CHECK_OUT
  BREAK_OUT
  BREAK_IN
  AUTO
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
  HOLIDAY
}

model RawAttendanceLog {
  id              String    @id @default(cuid())
  branchId        String
  deviceId        String
  employeeNumber  String
  punchTime       DateTime
  punchType       PunchType @default(AUTO)
  processed       Boolean   @default(false)
  processingError String?
  rawPayload      Json?
  createdAt       DateTime  @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, deviceId, employeeNumber, punchTime])
  @@index([branchId])
  @@index([employeeNumber])
  @@index([punchTime])
  @@index([processed])
  @@map("raw_attendance_logs")
}

model AttendanceRecord {
  id                 String           @id @default(cuid())
  employeeId         String
  branchId           String
  date               DateTime         // UTC midnight representing calendar day
  shiftId            String?
  checkIn            DateTime?
  checkOut           DateTime?
  totalWorkMinutes   Int              @default(0)
  overtimeMinutes    Int              @default(0)
  lateMinutes        Int              @default(0)
  earlyExitMinutes   Int              @default(0)
  status             AttendanceStatus @default(ABSENT)
  isManualCorrection Boolean          @default(false)
  correctionReason   String?
  approvedByUserId   String?
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([branchId])
  @@index([date])
  @@index([status])
  @@map("attendance_records")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id                  String    @id @default(cuid())
  companyId           String
  name                String
  code                String
  description         String?
  defaultDaysPerYear  Int       @default(14)
  isPaid              Boolean   @default(true)
  requiresApproval    Boolean   @default(true)
  carryForwardMaxDays Int       @default(0)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("leave_types")
}

model LeaveBalance {
  id                 String    @id @default(cuid())
  employeeId         String
  leaveTypeId        String
  year               Int
  entitledDays       Int       @default(0)
  carriedForwardDays Int       @default(0)
  usedDays           Int       @default(0)
  pendingDays        Int       @default(0)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([year])
  @@map("leave_balances")
}

model LeaveRequest {
  id               String             @id @default(cuid())
  employeeId       String
  branchId         String
  leaveTypeId      String
  startDate        DateTime           // UTC midnight
  endDate          DateTime           // UTC midnight
  daysCount        Int
  reason           String
  status           LeaveRequestStatus @default(PENDING)
  approvedByUserId String?
  approvalNotes    String?
  rejectionReason  String?
  approvedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([branchId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate])
  @@map("leave_requests")
}


